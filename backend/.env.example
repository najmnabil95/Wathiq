APP_NAME="IT-EDMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SANCTUM_EXPIRATION=43200

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=it_edms_db
DB_USERNAME=root
DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=""

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── IT-EDMS: initial admin account (used by AdminUserSeeder) ──
# Leave ADMIN_PASSWORD commented out to keep the seeder default;
# set a strong value here before running `migrate --seed` in production.
ADMIN_NAME="System Administrator"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@edms.local
# ADMIN_PASSWORD=

# ── IT-EDMS: demo accounts password (manager/staff/approver) ──
# Same rule: commented out keeps the seeder default.
# DEMO_PASSWORD=

# ── IT-EDMS: backups (edms:backup) ──
EDMS_BACKUP_PATH=D:/IT-EDMS-Backups
EDMS_BACKUP_KEEP=14
EDMS_MYSQLDUMP=C:/xampp/mysql/bin/mysqldump.exe

# ── IT-EDMS: attachment text extraction (optional) ──
TESSERACT_PATH=

# ── IT-EDMS: Office → PDF preview (LibreOffice headless) ──
# Install LibreOffice, then leave blank to auto-detect, or set the soffice binary.
# EDMS_SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
EDMS_OFFICE_TIMEOUT=60

# ── IT-EDMS: dev-only SPA redirect when the frontend is not built ──
FRONTEND_URL=http://localhost:5173

VITE_APP_NAME=""
